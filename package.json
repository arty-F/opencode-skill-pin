{
  "name": "opencode-skill-pin",
  "version": "0.1.0",
  "description": "Keep activated OpenCode skills in system instructions across compaction and restarts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arty-F/opencode-skill-pin.git"
  },
  "homepage": "https://github.com/arty-F/opencode-skill-pin#readme",
  "bugs": "https://github.com/arty-F/opencode-skill-pin/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build:dist": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 120000",
    "test:installed": "bun run build:dist && bun test test/installed.test.ts --timeout 120000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run build:dist && bun test --timeout 120000"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@opencode/sdk": "2.2.5",
    "@types/bun": "1.3.11",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "compaction",
    "context"
  ]
}
